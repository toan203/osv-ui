  "description": "MCP server for osv-ui — scan npm, Python, Go, Rust, Java, PHP, and Ruby projects for CVEs with a human-reviewed dashboard",
  "type": "module",
  "bin": {
    "osv-ui-mcp": "./bin/osv-ui-mcp.js"
  },
  "keywords": [
    "mcp",
